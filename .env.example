# Standalone landing site -> deployed LNYQ application routes
VITE_LNYQ_APP_URL=http://localhost:5173/trade
VITE_LNYQ_LAUNCHPAD_URL=http://localhost:5173/launchpad
VITE_LNYQ_CREATOR_URL=http://localhost:5173/create
VITE_LNYQ_AUTH_URL=http://localhost:5173/auth

# Docs, terms and privacy. Until these point somewhere real the site serves a holding page at /docs, /terms and /privacy.
VITE_LNYQ_DOCS_URL=
VITE_LNYQ_TERMS_URL=
VITE_LNYQ_PRIVACY_URL=

# Delivery endpoint for the access-code and project-submission forms. The
# site POSTs JSON {kind, ...fields, email, submittedAt, page} to it and treats
# HTTP 409 as "already submitted". Leave empty until an endpoint exists; the
# forms then say so and offer email instead.
VITE_LNYQ_FORMS_URL=
